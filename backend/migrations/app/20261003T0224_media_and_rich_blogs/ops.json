  {
    "id": "data.public.Blog.excerpt",
    "label": "Backfill blog excerpts",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "excerpt",
        "table": "Blog"
      }
    },
    "precheck": [
      {
        "description": "allow excerpt backfill",
        "sql": "SELECT true AS \"result\""
      }
    ],
    "execute": [
      {
        "description": "derive excerpts from plain text",
        "sql": "UPDATE \"public\".\"Blog\" SET \"excerpt\" = left(regexp_replace(\"body\", E'\\s+', ' ', 'g'), 200) WHERE \"excerpt\" IS NULL"
      }
    ],
    "postcheck": [
      {
        "description": "verify excerpts are filled",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"Blog\" WHERE \"excerpt\" IS NULL) AS \"result\""
      }
    ]
  },
