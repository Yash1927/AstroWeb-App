# Copy this file to `.env` and replace every placeholder you need.

# Local backend port. Defaults to 3000 when omitted.
PORT="3000"
# Controls production-only cookie security. Use `production` in production.
NODE_ENV="development"

# Neon POOLED connection string (host contains "-pooler"), used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon DIRECT connection string, used only for migrations (prisma.config.ts).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Opt-in flags for the destructive pending-fix integration suite. Use only with an isolated Neon branch URL.
RUN_NEON_BRANCH_TESTS="0"
NEON_BRANCH_NAME="pending-fixes-7-8-YYYYMMDD"

# Exact frontend origin, used for CORS, cookies and the WebSocket origin check.
APP_ORIGIN="http://localhost:5173"
SESSION_SECRET="at-least-32-random-characters"

# Google sign-in (OAuth client of type "Web application").
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Razorpay test credentials. Secrets never go to the browser.
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="xxxx"
RAZORPAY_WEBHOOK_SECRET="xxxx"

# Owner account. The seed script will read these once and store only a hash.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-now"

# TURN relay for in-app calls.
TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
TURN_SECRET="xxxx"

APP_TIMEZONE="Asia/Kolkata"

# --- Cloudflare R2 media storage (README §19.1). Never commit real values. ---
# Cloudflare dashboard → R2 object storage → Overview → "Account Details" → Account ID
R2_ACCOUNT_ID=""
# R2 → Overview → Account Details → API Tokens "Manage" → Create token ("Object Read & Write", scoped to the bucket)
R2_ACCESS_KEY_ID=""
# Shown ONCE when you create the token. Copy it immediately.
R2_SECRET_ACCESS_KEY=""
# The bucket name you created
R2_BUCKET="astro-shashank-media"
# Bucket → Settings → "Public Development URL" → Enable (development only). Looks like https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=""
